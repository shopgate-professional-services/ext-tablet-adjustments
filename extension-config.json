{
  "version": "2.0.0-beta.1",
  "id": "@shopgate-project/tablet-adjustments",
  "components": [
    {
      "id": "ProductMedia",
      "path": "frontend/portals/Media/index.jsx",
      "target": "component.product-media-section",
      "type": "portals"
    },
    {
      "id": "NullifyWithMediaContext",
      "path": "frontend/portals/NullifyWithMediaContext/index.jsx",
      "target": [
        "product.header",
        "product.unit-quantity-picker"
      ],
      "type": "portals"
    },
    {
      "id": "Nullify",
      "path": "frontend/portals/Nullify/index.jsx",
      "target": [
        "product.add-to-cart-bar",
        "product.ctas.favorites",
        "product.ctas.share"
      ],
      "type": "portals"
    }
  ],
  "configuration": {
    "colorPdpBox": {
      "type": "admin",
      "destination": "frontend",
      "default": "",
      "params": {
        "type": "text",
        "label": "Background color of the right box on PDP"
      }
    }
  }
}
